{% comment %}
  Trophy Mart - Cart page (design mirrors src/components/CartPage.tsx).

  PURE CSS. Upload ONLY sections/cart-page.liquid.
  Install: Customize -> Cart -> Add section -> "Cart Page".
  Remove Dawn's default Cart items / Cart footer sections so only this renders.

  - Real cart lines with image, SKU, title, variant, engraving properties.
  - Quantity stepper and remove use /cart/change.js, then reload.
  - Order summary shows live subtotal, discounts, total and a free-shipping
    progress bar; checkout posts to Shopify's standard cart form.
{% endcomment %}

<style>
@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700&family=Manrope:wght@400;500;600;700;800&display=swap");

.tm-ct, .tm-ct *, .tm-ct *::before, .tm-ct *::after { box-sizing: border-box; }
.tm-ct { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #161C24; line-height: 1.4; background: #fff; }
:where(.tm-ct) :where(h1, h2, h3, p, ul, li) { margin: 0; padding: 0; }
:where(.tm-ct) :where(ul) { list-style: none; }
:where(.tm-ct) :where(a) { color: inherit; text-decoration: none; }
:where(.tm-ct) :where(img) { display: block; border: 0; max-width: none; }
:where(.tm-ct) :where(button) { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; -webkit-appearance: none; appearance: none; }
:where(.tm-ct) :where(form) { margin: 0; }
.tm-ct [hidden] { display: none !important; }
.tm-ct :focus-visible { outline: 2px solid #C5222A; outline-offset: 2px; }

.ct-wrap { max-width: 1152px; margin: 0 auto; padding: 0 16px; }

/* Breadcrumb */
.ct-crumbs { padding: 32px 0 28px; }
.ct-crumb { font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: #64748B; }
.ct-crumb a { transition: color 0.15s; }
.ct-crumb a:hover { color: #C5222A; }
.ct-sep { margin: 0 10px; color: #CBD5E1; }
.ct-current { color: #0E233E; font-weight: 600; }

/* Heading */
.ct-head { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
.ct-rule { width: 40px; height: 1px; background: #C59B27; }
.ct-kicker { margin-top: 16px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.28em; color: #C5222A; }
.ct-title { margin-top: 8px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 36px; font-weight: 700; color: #0E233E; line-height: 1.05; }
.ct-title em { font-style: italic; color: #C5222A; }
.ct-sub { margin-top: 12px; font-size: 12px; letter-spacing: 0.025em; color: #64748B; }
.ct-continue { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: #0E233E; border-bottom: 1px solid rgba(14, 35, 62, 0.3); padding-bottom: 4px; transition: color 0.15s, border-color 0.15s; }
.ct-continue:hover { color: #C5222A; border-color: #C5222A; }
.ct-continue svg { width: 13px; height: 13px; }

/* Layout */
.ct-grid { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start; padding-bottom: 96px; }
.ct-lines { display: flex; flex-direction: column; gap: 16px; }

/* Line item */
.ct-item { display: flex; flex-direction: column; border: 1px solid #E5E0D4; background: #fff; }
.ct-media { position: relative; width: 100%; height: 176px; background: #FAF9F5; border-bottom: 1px solid #E5E0D4; display: flex; align-items: center; justify-content: center; padding: 12px; flex-shrink: 0; }
.ct-media img { max-height: 144px; max-width: 75%; object-fit: contain; }
.ct-badge { position: absolute; top: 0; left: 0; background: #0E233E; color: #fff; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; padding: 6px 10px; }
.ct-media-fallback { width: 96px; height: 128px; display: flex; align-items: center; justify-content: center; }
.ct-media-fallback svg { width: 100%; height: 100%; }

.ct-body { flex: 1; min-width: 0; padding: 20px; display: flex; flex-direction: column; }
.ct-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.ct-sku { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em; color: #C59B27; }
.ct-name { margin-top: 4px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #0E233E; line-height: 1.375; }
.ct-name a:hover { color: #C5222A; }
.ct-variant { margin-top: 6px; font-size: 11px; color: #64748B; line-height: 1.6; }
.ct-meta { margin-top: 4px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: #94A3B8; }
.ct-remove { margin: -8px -8px 0 0; padding: 8px; color: #94A3B8; transition: color 0.15s; flex-shrink: 0; }
.ct-remove:hover { color: #C5222A; }
.ct-remove svg { width: 16px; height: 16px; }

/* Line properties (engraving etc.) */
.ct-props { margin-top: 16px; background: #FAF9F5; border: 1px solid #E5E0D4; padding: 14px 16px; }
.ct-props-head { display: flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: #0E233E; }
.ct-props-head svg { width: 11px; height: 11px; color: #C5222A; }
.ct-prop { margin-top: 6px; display: flex; gap: 8px; font-size: 11px; color: #475569; line-height: 1.5; }
.ct-prop-name { font-weight: 600; color: #0E233E; }
.ct-prop-name::after { content: ':'; }

/* Quantity + totals */
.ct-foot { margin-top: 20px; padding-top: 16px; border-top: 1px solid #E5E0D4; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
.ct-qty-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: #64748B; margin-bottom: 8px; }
.ct-qty { display: flex; border: 1px solid #E5E0D4; background: #fff; }
.ct-qty-btn { width: 40px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; color: #0E233E; transition: background-color 0.15s; }
.ct-qty-btn:hover { background: #FAF9F5; }
.ct-qty-btn:disabled { opacity: 0.5; cursor: wait; }
.ct-qty-value { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; color: #0E233E; font-variant-numeric: tabular-nums; border-left: 1px solid #E5E0D4; border-right: 1px solid #E5E0D4; }
.ct-totals { text-align: right; }
.ct-unit { font-size: 10px; color: #64748B; font-variant-numeric: tabular-nums; }
.ct-line-total { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; font-weight: 700; color: #0E233E; font-variant-numeric: tabular-nums; line-height: 1.1; }
.ct-line-compare { font-size: 10px; color: #94A3B8; text-decoration: line-through; font-variant-numeric: tabular-nums; }

/* Assurance strip */
.ct-trust { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 1px; background: #E5E0D4; border: 1px solid #E5E0D4; }
.ct-trust-item { background: #fff; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 20px 8px; text-align: center; }
.ct-trust-item svg { width: 17px; height: 17px; color: #C59B27; }
.ct-trust-item span { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #475569; line-height: 1.25; }

/* Summary */
.ct-side { display: flex; flex-direction: column; gap: 16px; }
.ct-summary { border: 1px solid #E5E0D4; background: #fff; }
.ct-summary-head { padding: 20px 24px; border-bottom: 1px solid #E5E0D4; }
.ct-summary-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #0E233E; }
.ct-summary-note { margin-top: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: #64748B; }
.ct-summary-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 12px; font-size: 12px; color: #475569; }
.ct-row { display: flex; justify-content: space-between; gap: 16px; }
.ct-row strong { color: #0E233E; font-weight: 700; font-variant-numeric: tabular-nums; }
.ct-row-save { color: #C5222A; }
.ct-row-total { padding-top: 12px; margin-top: 4px; border-top: 1px solid #E5E0D4; align-items: baseline; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #0E233E; }
.ct-row-total span:last-child { font-variant-numeric: tabular-nums; }

.ct-ship { padding: 0 24px 20px; }
.ct-ship-label { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: #64748B; }
.ct-ship-label.is-free { color: #0E233E; }
.ct-ship-label svg { width: 13px; height: 13px; color: #059669; flex-shrink: 0; }
.ct-ship-bar { margin-top: 8px; height: 4px; width: 100%; background: #E5E0D4; }
.ct-ship-fill { height: 100%; background: #C59B27; transition: width 0.5s; }

.ct-checkout { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
.ct-btn { width: 100%; height: 48px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; transition: background-color 0.15s, color 0.15s; }
.ct-btn-checkout { background: #C5222A; color: #fff; }
.ct-btn-checkout:hover { background: #991B1B; }
.ct-btn svg { width: 15px; height: 15px; }
.ct-secure { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 10px; color: #64748B; }
.ct-secure svg { width: 12px; height: 12px; color: #059669; flex-shrink: 0; }

.ct-consult { border: 1px solid #E5E0D4; background: #FAF9F5; padding: 20px; }
.ct-consult-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 700; color: #0E233E; }
.ct-consult-text { margin-top: 6px; font-size: 11px; color: #64748B; line-height: 1.625; }
.ct-consult-link { margin-top: 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: #0E233E; border-bottom: 1px solid rgba(14, 35, 62, 0.3); padding-bottom: 4px; transition: color 0.15s, border-color 0.15s; }
.ct-consult-link:hover { color: #C5222A; border-color: #C5222A; }
.ct-consult-link svg { width: 12px; height: 12px; }

/* Empty state */
.ct-empty { border: 1px solid #E5E0D4; background: #fff; padding: 80px 24px; text-align: center; }
.ct-empty-icon { width: 64px; height: 64px; margin: 0 auto; border: 1px solid #E5E0D4; background: #FAF9F5; display: flex; align-items: center; justify-content: center; color: #94A3B8; }
.ct-empty-icon svg { width: 26px; height: 26px; }
.ct-empty-title { margin-top: 24px; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; font-weight: 700; color: #0E233E; }
.ct-empty-text { margin: 8px auto 0; max-width: 384px; font-size: 12px; color: #64748B; line-height: 1.625; }
.ct-empty-actions { margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
.ct-empty-actions .ct-btn { width: auto; padding: 0 24px; }
.ct-btn-outline { border: 1px solid #0E233E; background: #fff; color: #0E233E; }
.ct-btn-outline:hover { background: #0E233E; color: #fff; }

@media (min-width: 640px) {
  .ct-wrap { padding: 0 24px; }
  .ct-head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  .ct-continue { align-self: auto; }
  .ct-title { font-size: 48px; }
  .ct-sub { font-size: 12px; }
  .ct-item { flex-direction: row; }
  .ct-media { width: 144px; height: auto; border-bottom: 0; border-right: 1px solid #E5E0D4; padding: 12px; }
  .ct-media img { max-height: 176px; }
  .ct-body { padding: 24px; }
  .ct-name { font-size: 24px; }
  .ct-empty-title { font-size: 30px; }
}

@media (min-width: 1024px) {
  .ct-grid { grid-template-columns: 2fr 1fr; gap: 40px; }
  .ct-side { position: sticky; top: 32px; }
}
</style>

{%- assign free_threshold = section.settings.free_ship_threshold | default: 5000 | times: 100 -%}
{%- assign cart_subtotal = cart.items_subtotal_price -%}
{%- if free_threshold > 0 and cart_subtotal < free_threshold -%}
  {%- assign shipping_gap = free_threshold | minus: cart_subtotal -%}
  {%- assign shipping_pct = cart_subtotal | times: 100.0 | divided_by: free_threshold -%}
{%- else -%}
  {%- assign shipping_gap = 0 -%}
  {%- assign shipping_pct = 100 -%}
{%- endif -%}
{%- if shipping_pct > 100 -%}{%- assign shipping_pct = 100 -%}{%- endif -%}

<div class="tm-ct" data-tm-cart>
  <!-- Breadcrumb -->
  <div class="ct-wrap ct-crumbs">
    <p class="ct-crumb">
      <a href="{{ shop.url }}">Home</a>
      <span class="ct-sep">/</span>
      <span class="ct-current">{{ section.settings.page_label }}</span>
    </p>
  </div>

  <div class="ct-wrap">
    <!-- Heading -->
    <div class="ct-head">
      <div>
        <div class="ct-rule"></div>
        <p class="ct-kicker">{{ section.settings.kicker }}</p>
        <h1 class="ct-title">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
        <p class="ct-sub">
          {%- if cart.item_count > 0 -%}
            {{ cart.item_count }} {% if cart.item_count == 1 %}line{% else %}lines{% endif %} prepared for engraving
          {%- else -%}
            Nothing selected yet
          {%- endif -%}
        </p>
      </div>

      <a class="ct-continue" href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}">
        Continue Browsing
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>

    {%- if cart.item_count == 0 -%}
      <!-- Empty state -->
      <div class="ct-empty">
        <div class="ct-empty-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><path d="M3 6h18"></path><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
        <h2 class="ct-empty-title">{{ section.settings.empty_title }}</h2>
        <p class="ct-empty-text">{{ section.settings.empty_text }}</p>
        <div class="ct-empty-actions">
          <a class="ct-btn ct-btn-checkout" href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}">
            Browse Masterworks
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a class="ct-btn ct-btn-outline" href="{{ section.settings.consultant_link }}" target="_blank" rel="noopener noreferrer">Speak To A Consultant</a>
        </div>
      </div>
    {%- else -%}
      <div class="ct-grid">
        <!-- Line items -->
        <div class="ct-lines">
          {%- for item in cart.items -%}
            {%- assign ct_height = item.product.metafields.custom.height.value -%}
            {%- if ct_height == blank -%}
              {%- assign ct_height = item.variant.metafields.custom.height.value -%}
            {%- endif -%}
            <article class="ct-item" data-tm-line data-line="{{ forloop.index }}">
              <div class="ct-media">
                <span class="ct-badge">{{ item.product.type | default: 'Trophy Mart' }}</span>
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.title | escape }}" loading="lazy">
                {%- else -%}
                  <span class="ct-media-fallback">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#B98A2E" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8"></path><path d="M12 21v-6"></path><path d="M7 3h10v6a5 5 0 0 1-10 0V3Z"></path><path d="M7 5H4v2a3 3 0 0 0 3 3"></path><path d="M17 5h3v2a3 3 0 0 1-3 3"></path></svg>
                  </span>
                {%- endif -%}
              </div>

              <div class="ct-body">
                <div class="ct-top">
                  <div>
                    <p class="ct-sku">{{ item.sku | default: item.product.handle }}</p>
                    <h2 class="ct-name"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                    {%- unless item.variant.title contains 'Default Title' -%}
                      <p class="ct-variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- if ct_height != blank -%}
                      <p class="ct-meta">{{ ct_height }} &middot; {{ section.settings.dispatch_note }}</p>
                    {%- endif -%}
                  </div>

                  <button type="button" class="ct-remove" data-tm-remove aria-label="Remove {{ item.product.title | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                </div>

                {%- assign has_props = false -%}
                {%- for p in item.properties -%}
                  {%- assign first_char = p.first | slice: 0 -%}
                  {%- if p.last != blank and first_char != '_' -%}{%- assign has_props = true -%}{%- endif -%}
                {%- endfor -%}

                {%- if has_props -%}
                  <div class="ct-props">
                    <p class="ct-props-head">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path></svg>
                      Personalisation
                    </p>
                    {%- for p in item.properties -%}
                      {%- assign first_char = p.first | slice: 0 -%}
                      {%- if p.last != blank and first_char != '_' -%}
                        <p class="ct-prop"><span class="ct-prop-name">{{ p.first }}</span><span>{{ p.last }}</span></p>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="ct-foot">
                  <div>
                    <p class="ct-qty-label">Quantity</p>
                    <div class="ct-qty">
                      <button type="button" class="ct-qty-btn" data-tm-qty="-1" aria-label="Decrease quantity">&minus;</button>
                      <span class="ct-qty-value">{{ item.quantity }}</span>
                      <button type="button" class="ct-qty-btn" data-tm-qty="1" aria-label="Increase quantity">+</button>
                    </div>
                  </div>

                  <div class="ct-totals">
                    <p class="ct-unit">{{ item.final_price | money }} / unit</p>
                    <p class="ct-line-total">{{ item.final_line_price | money }}</p>
                    {%- if item.original_line_price > item.final_line_price -%}
                      <p class="ct-line-compare">{{ item.original_line_price | money }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </article>
          {%- endfor -%}

          <!-- Assurance strip -->
          <div class="ct-trust">
            <div class="ct-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
              <span>{{ section.settings.badge_1 }}</span>
            </div>
            <div class="ct-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"></path></svg>
              <span>{{ section.settings.badge_2 }}</span>
            </div>
            <div class="ct-trust-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg>
              <span>{{ section.settings.badge_3 }}</span>
            </div>
          </div>
        </div>

        <!-- Summary -->
        <aside class="ct-side">
          <div class="ct-summary">
            <div class="ct-summary-head">
              <h2 class="ct-summary-title">Order Summary</h2>
              <p class="ct-summary-note">{{ section.settings.summary_note }}</p>
            </div>

            <div class="ct-summary-body">
              <div class="ct-row">
                <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
                <strong>{{ cart.items_subtotal_price | money }}</strong>
              </div>

              {%- if cart.total_discount > 0 -%}
                <div class="ct-row ct-row-save">
                  <span>Savings</span>
                  <strong>&minus; {{ cart.total_discount | money }}</strong>
                </div>
              {%- endif -%}

              <div class="ct-row">
                <span>Delivery &amp; Casket</span>
                <strong>{% if shipping_gap == 0 %}Complimentary{% else %}At dispatch{% endif %}</strong>
              </div>

              <div class="ct-row ct-row-total">
                <span>Total</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
            </div>

            <div class="ct-ship">
              <p class="ct-ship-label {% if shipping_gap == 0 %}is-free{% endif %}">
                {%- if shipping_gap == 0 -%}
                  Free insured shipping unlocked
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                {%- else -%}
                  {{ shipping_gap | money }} to free shipping
                {%- endif -%}
              </p>
              <div class="ct-ship-bar">
                <div class="ct-ship-fill" style="width: {{ shipping_pct }}%"></div>
              </div>
            </div>

            <form action="{{ routes.cart_url }}" method="post" novalidate class="ct-checkout">
              <button type="submit" name="checkout" class="ct-btn ct-btn-checkout">
                Proceed To Checkout
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </button>
              <p class="ct-secure">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>
                Secure checkout &middot; Insured air express
              </p>
            </form>
          </div>

          <div class="ct-consult">
            <h3 class="ct-consult-title">{{ section.settings.consult_title }}</h3>
            <p class="ct-consult-text">{{ section.settings.consult_text }}</p>
            <a class="ct-consult-link" href="{{ section.settings.consultant_link }}" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
              Speak To A Consultant
            </a>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  'use strict';

  function changeLine(line, quantity) {
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ line: line, quantity: quantity })
    }).then(function (r) { return r.json(); });
  }

  function init() {
    var root = document.querySelector('[data-tm-cart]');
    if (!root || root.getAttribute('data-tm-init') === '1') return;
    root.setAttribute('data-tm-init', '1');

    root.querySelectorAll('[data-tm-line]').forEach(function (row) {
      var line = parseInt(row.getAttribute('data-line'), 10);

      row.querySelectorAll('[data-tm-qty]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var delta = parseInt(btn.getAttribute('data-tm-qty'), 10);
          var display = row.querySelector('.ct-qty-value');
          var current = display ? parseInt(display.textContent, 10) : 1;
          var next = Math.max(0, current + delta);
          row.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
          changeLine(line, next).then(function () { window.location.reload(); }).catch(function () {
            row.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
          });
        });
      });

      var removeBtn = row.querySelector('[data-tm-remove]');
      if (removeBtn) {
        removeBtn.addEventListener('click', function () {
          removeBtn.disabled = true;
          changeLine(line, 0).then(function () { window.location.reload(); }).catch(function () {
            removeBtn.disabled = false;
          });
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', function () {
    var root = document.querySelector('[data-tm-cart]');
    if (root) root.removeAttribute('data-tm-init');
    init();
  });
})();
</script>

